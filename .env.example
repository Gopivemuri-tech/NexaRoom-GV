# Create a local .env file; never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Development database. Create credentials locally.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nexaroom
MYSQL_USER=nexaroom_local
MYSQL_PASSWORD=replace-with-local-db-password

# Optional setup user (choose secure values before running setup_nexaroom)
NEXAROOM_ADMIN_USERNAME=admin
NEXAROOM_ADMIN_EMAIL=admin@example.invalid
NEXAROOM_ADMIN_PASSWORD=replace-with-your-own-strong-password

# For shared meeting links on other devices, configure your reachable URL.
NEXAROOM_PUBLIC_BASE_URL=

# Optional TURN server (use credentials from a private .env only)
NEXAROOM_TURN_URL=
NEXAROOM_TURN_USERNAME=
NEXAROOM_TURN_CREDENTIAL=
